@@ -0,0 +1,54 @@
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+import 'package:http/http.dart' as http;
+
+/// Logs only method, path, status/error category and elapsed time.
+/// Never records query strings, headers, request/response bodies or tokens.
+class SanitizedHttpTraceClient extends http.BaseClient {
+  SanitizedHttpTraceClient({http.Client? inner})
+      : _inner = inner ?? http.Client();
+
+  final http.Client _inner;
+  final List<String> events = [];
+
+  @override
+  Future<http.StreamedResponse> send(http.BaseRequest request) async {
+    final stopwatch = Stopwatch()..start();
+    final path = request.url.path.replaceAll(
+      RegExp(r'/[0-9a-fA-F-]{20,}'),
+      '/:id',
+    );
+    try {
+      final response = await _inner.send(request).timeout(
+            const Duration(seconds: 30),
+            onTimeout: () => throw TimeoutException('transport timeout'),
+          );
+      _record(
+        'method=${request.method} path=$path status=${response.statusCode} '
+        'elapsed_ms=${stopwatch.elapsedMilliseconds}',
+      );
+      return response;
+    } on TimeoutException {
+      _record(
+        'method=${request.method} path=$path result=timeout '
+        'elapsed_ms=${stopwatch.elapsedMilliseconds}',
+      );
+      rethrow;
+    } catch (error) {
+      _record(
+        'method=${request.method} path=$path result=transport_error '
+        'type=${error.runtimeType} elapsed_ms=${stopwatch.elapsedMilliseconds}',
+      );
+      rethrow;
+    }
+  }
+
+  void _record(String event) {
+    events.add(event);
+    debugPrint('[R3-HTTP] $event');
+  }
+
+  @override
+  void close() => _inner.close();
+}
