+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:supabase_flutter/supabase_flutter.dart';
+
+const _clubA = '22000000-0000-0000-0000-000000000001';
+
+void main() {
+  late SupabaseClient client;
+  final password = Platform.environment['RC1_TEST_PASSWORD'] ?? '';
+
+  setUpAll(() async {
+    // Supabase Flutter persists tokens through this plugin; provide the test
+    // implementation before initialization. Clear the widget-test fake HTTP
+    // override because this file is explicitly an opt-in live local API test.
+    SharedPreferences.setMockInitialValues(<String, Object>{});
+    HttpOverrides.global = null;
+    AppConfig.validateForRealMode();
+    if (AppConfig.demoMode) {
+      throw StateError('Live API tests must run with DEMO_MODE=false.');
+    }
+    if (password.isEmpty) {
+      throw StateError('RC1_TEST_PASSWORD is required in the test process.');
+    }
+    await Supabase.initialize(
+      url: AppConfig.supabaseUrl,
+      publishableKey: AppConfig.supabasePublishableKey,
+    );
+    client = Supabase.instance.client;
+  });
+
+  tearDown(() async {
+    await client.auth.signOut();
+    AppSession.instance.clear();
+  });
+
+  test('real GoTrue login and logout through AuthService', () async {
+    await AuthService.instance.signIn(
+      'rc1-api-president-a@local.invalid',
+      password,
+    );
+
+    expect(client.auth.currentUser?.email, 'rc1-api-president-a@local.invalid');
+    expect(AppSession.instance.authenticated, isTrue);
+    expect(AppSession.instance.clubId, _clubA);
+
+    await AuthService.instance.signOut();
