+
+bool _clearR3PersistedAuthSession() {
+  final storage = globalContext.getProperty<JSObject?>('localStorage'.toJS);
+  if (storage == null) throw StateError('Browser localStorage is unavailable.');
+  final hostPrefix = Uri.parse(AppConfig.supabaseUrl).host.split('.').first;
+  final key = 'sb-$hostPrefix-auth-token';
+  final previous = storage.callMethod<JSString?>('getItem'.toJS, key.toJS);
+  final hadSession = previous != null && previous.toDart.isNotEmpty;
+  storage.callMethod<JSAny?>('removeItem'.toJS, key.toJS);
+  if (storage.callMethod<JSString?>('getItem'.toJS, key.toJS) != null) {
+    throw StateError('Prior local Auth session could not be cleared.');
+  }
+  return hadSession;
+}
+
+String? _destinationLabel(Widget widget) {
+  if (widget is NavigationDrawerDestination && widget.label is Text) {
+    return (widget.label as Text).data;
+  }
+  return null;
+}
+
+Future<void> _login(WidgetTester tester, String email) async {
+  await _pumpUntil(tester, find.byType(LoginScreen));
+  debugPrint(
+    '[R3-PILOT] step=login-form '
+    'login=${find.byType(LoginScreen).evaluate().isNotEmpty} '
+    'fields=${find.byType(TextField).evaluate().length} '
+    'authUser=${Supabase.instance.client.auth.currentUser != null} '
+    'appSession=${AppSession.instance.authenticated}',
+  );
+  await tester.enterText(find.byType(TextField).at(0), email);
+  await tester.enterText(find.byType(TextField).at(1), _password);
+  expect(find.widgetWithText(FilledButton, 'Entrar'), findsOneWidget);
+  await tester.tap(find.widgetWithText(FilledButton, 'Entrar'));
+  debugPrint('[R3-PILOT] step=login-button-tapped');
+  final end = DateTime.now().add(const Duration(seconds: 30));
+  while (DateTime.now().isBefore(end)) {
+    if (find.byType(ShellScreen).evaluate().isNotEmpty) {
+      debugPrint(
+        '[R3-PILOT] step=login-shell '
+        'authUser=${Supabase.instance.client.auth.currentUser != null} '
+        'appSession=${AppSession.instance.authenticated}',
+      );
+      return;
+    }
+    await tester.pump(const Duration(milliseconds: 200));
+  }
+  final loginText = find
+      .descendant(of: find.byType(LoginScreen), matching: find.byType(Text))
+      .evaluate()
+      .map((element) => (element.widget as Text).data ?? '')
+      .where((text) => text.isNotEmpty)
+      .toList();
+  final screen = find.byType(LoginScreen).evaluate().isNotEmpty
+      ? 'LoginScreen'
+      : find.byType(ShellScreen).evaluate().isNotEmpty
+          ? 'ShellScreen'
+          : find.byType(CircularProgressIndicator).evaluate().isNotEmpty
+              ? 'Loading'
+              : 'Other';
+  debugPrint(
+    '[R3-PILOT] step=login-timeout screen=$screen '
+    'authUser=${Supabase.instance.client.auth.currentUser != null} '
+    'appSession=${AppSession.instance.authenticated} '
+    'loginText=$loginText',
+  );
+  throw TestFailure('Login real não chegou ao ShellScreen; screen=$screen');
+}
+
+Future<void> _loginExpectRejected(WidgetTester tester, String email) async {
+  await _pumpUntil(tester, find.byType(LoginScreen));
+  await tester.enterText(find.byType(TextField).at(0), email);
+  await tester.enterText(find.byType(TextField).at(1), _password);
+  await tester.tap(find.widgetWithText(FilledButton, 'Entrar'));
+  await _pumpFor(tester, const Duration(seconds: 4));
+  expect(find.byType(LoginScreen), findsOneWidget);
+}
+
+Future<void> _logout(WidgetTester tester) async {
+  final logout = find.text('Terminar sessão').first;
+  await tester.ensureVisible(logout);
+  await tester.tap(logout);
+  await _pumpUntil(tester, find.byType(LoginScreen));
+}
+
+Future<void> _selectModule(WidgetTester tester, String title) async {
+  final destination = find.widgetWithText(NavigationDrawerDestination, title);
+  if (destination.evaluate().isNotEmpty) {
+    await tester.ensureVisible(destination);
+    await tester.tap(destination);
+    await _pumpFor(tester, const Duration(milliseconds: 700));
+    return;
+  }
+  final navigationLabel = find.text(title);
+  if (navigationLabel.evaluate().isNotEmpty) {
+    await tester.ensureVisible(navigationLabel.first);
+    await tester.tap(navigationLabel.first);
+    await _pumpFor(tester, const Duration(milliseconds: 700));
+    return;
+  }
+  throw TestFailure('Módulo não disponível na navegação: $title');
+}
+
+Future<void> _pumpUntil(
+  WidgetTester tester,
+  Finder finder, {
+  Duration timeout = const Duration(seconds: 30),
+  bool allowMissing = false,
+}) async {
+  final end = DateTime.now().add(timeout);
+  while (DateTime.now().isBefore(end)) {
+    if (finder.evaluate().isNotEmpty) return;
+    await tester.pump(const Duration(milliseconds: 200));
+  }
+  if (!allowMissing) {
+    expect(finder, findsOneWidget, reason: 'Tempo limite a aguardar $finder');
+  }
+}
+
+Future<void> _pumpFor(WidgetTester tester, Duration duration) async {
+  final end = DateTime.now().add(duration);
+  while (DateTime.now().isBefore(end)) {
+    await tester.pump(const Duration(milliseconds: 100));
+  }
+}
+
+Future<String> _waitForTreasuryUi(WidgetTester tester) async {
+  final deadline = DateTime.now().add(const Duration(seconds: 35));
+  var loadingSeen = false;
+  while (DateTime.now().isBefore(deadline)) {
+    if (find.text('Saldo global').evaluate().isNotEmpty) {
+      final amounts = find
+          .textContaining('€')
+          .evaluate()
+          .map((element) {
+            final widget = element.widget;
+            return widget is Text ? widget.data ?? '' : '';
+          })
+          .where((value) => value.isNotEmpty)
+          .toList();
+      return 'loaded:${amounts.join('|')}';
+    }
+    final error = find.textContaining('Erro:').evaluate();
+    if (error.isNotEmpty) {
+      final value = (error.first.widget as Text).data ?? 'unknown';
+      return 'http_or_parse_error:${value.replaceAll(RegExp(r'[0-9a-fA-F-]{32,}'), '[id]')}';
+    }
+    loadingSeen = loadingSeen ||
+        find.byType(CircularProgressIndicator).evaluate().isNotEmpty;
+    await tester.pump(const Duration(milliseconds: 200));
+  }
+  return loadingSeen
+      ? 'pending_future_loading_indicator'
+      : 'no_treasury_content';
+}
+
+String _formatMoney(double amount) =>
+    '${amount.toStringAsFixed(2).replaceAll('.', ',')} €';
