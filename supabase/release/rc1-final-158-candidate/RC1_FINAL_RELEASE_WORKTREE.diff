+Future<void> _start(WidgetTester tester, String testCase) async {
+  expect(_password.length, greaterThanOrEqualTo(32));
+  final hadPersistedSession = _clearR3PersistedAuthSession();
+  debugPrint(
+    '[R3-AUTH] case=$testCase step=browser-storage-cleared '
+    'priorAuthSession=$hadPersistedSession',
+  );
+  debugPrint('[R3-AUTH] case=$testCase step=app.main');
+  await app.main();
+  final screen = await _waitForScreen(tester, testCase, 'bootstrap');
+  debugPrint('[R3-AUTH] case=$testCase step=bootstrap screen=$screen');
+}
+
+Future<void> _login(
+  WidgetTester tester,
+  String email,
+  String step,
+) async {
+  _record(tester, '$step — formulário antes de preencher');
+  expect(find.byType(LoginScreen), findsOneWidget, reason: 'passo=$step');
+  expect(find.byType(TextField), findsNWidgets(2), reason: 'passo=$step');
+  await tester.enterText(find.byType(TextField).at(0), email);
+  await tester.enterText(find.byType(TextField).at(1), _password);
+  expect(find.widgetWithText(FilledButton, 'Entrar'), findsOneWidget);
+  await tester.tap(find.widgetWithText(FilledButton, 'Entrar'));
+  _record(tester, step);
+}
+
+Future<void> _loginExpectRejected(
+  WidgetTester tester,
+  String email,
+  String step,
+  String expectedError,
+) async {
+  expect(find.byType(LoginScreen), findsOneWidget);
+  await _login(tester, email, 'login recusado submetido');
+  await _waitForError(tester, step, expectedError);
+  expect(find.byType(LoginScreen), findsOneWidget);
+  expect(find.byType(ShellScreen), findsNothing);
+  expect(Supabase.instance.client.auth.currentUser, isNull);
+  expect(AppSession.instance.authenticated, isFalse);
+  _record(tester, step);
+}
+
+Future<String> _waitForScreen(
+  WidgetTester tester,
+  String testCase,
+  String step,
+) async {
+  final end = DateTime.now().add(const Duration(seconds: 30));
+  while (DateTime.now().isBefore(end)) {
+    if (find.byType(LoginScreen).evaluate().isNotEmpty) return 'LoginScreen';
+    if (find.byType(ShellScreen).evaluate().isNotEmpty) return 'ShellScreen';
+    await tester.pump(const Duration(milliseconds: 200));
+  }
+  final state = _state(tester);
+  debugPrint('[R3-AUTH] case=$testCase step=$step timeout state=$state');
+  throw TestFailure('case=$testCase step=$step timeout; estado=$state');
+}
+
+Future<void> _waitFor(
+  WidgetTester tester,
+  Type widgetType,
+  String step,
+) async {
+  final end = DateTime.now().add(const Duration(seconds: 30));
+  while (DateTime.now().isBefore(end)) {
+    if (find.byType(widgetType).evaluate().isNotEmpty) return;
+    await tester.pump(const Duration(milliseconds: 200));
+  }
+  final state = _state(tester);
+  debugPrint('[R3-AUTH] step=$step timeout state=$state');
+  throw TestFailure('$step; estado=$state');
+}
+
+Future<void> _waitForError(
+  WidgetTester tester,
+  String step,
+  String expectedError,
+) async {
+  final end = DateTime.now().add(const Duration(seconds: 20));
+  while (DateTime.now().isBefore(end)) {
+    if (find.byType(LoginScreen).evaluate().isNotEmpty &&
+        find.byType(CircularProgressIndicator).evaluate().isEmpty &&
+        find.text(expectedError).evaluate().isNotEmpty) {
+      return;
+    }
+    await tester.pump(const Duration(milliseconds: 200));
+  }
+  final state = _state(tester);
+  debugPrint('[R3-AUTH] step=$step error-timeout state=$state');
+  debugPrint('[R3-AUTH] step=$step loginText=${_loginText(tester)}');
+  throw TestFailure('$step; estado=$state');
+}
+
+bool _clearR3PersistedAuthSession() {
+  final storage = globalContext.getProperty<JSObject?>('localStorage'.toJS);
+  if (storage == null) throw StateError('Browser localStorage is unavailable.');
+  final hostPrefix = Uri.parse(AppConfig.supabaseUrl).host.split('.').first;
+  final key = 'sb-$hostPrefix-auth-token';
+  final previous = storage.callMethod<JSString?>('getItem'.toJS, key.toJS);
+  final hadSession = previous != null && previous.toDart.isNotEmpty;
+  storage.callMethod<JSAny?>('removeItem'.toJS, key.toJS);
+  if (storage.callMethod<JSString?>('getItem'.toJS, key.toJS) != null) {
+    throw StateError('Prior local Auth session could not be cleared.');
+  }
+  return hadSession;
+}
+
+List<String> _loginText(WidgetTester tester) => find
+    .descendant(of: find.byType(LoginScreen), matching: find.byType(Text))
+    .evaluate()
+    .map((element) => (element.widget as Text).data ?? '')
+    .where((text) => text.isNotEmpty)
+    .toList();
+
+void _record(WidgetTester tester, String step) {
+  debugPrint('[R3-AUTH] step=$step state=${_state(tester)}');
+}
+
+String _state(WidgetTester tester) {
+  final screen = find.byType(LoginScreen).evaluate().isNotEmpty
+      ? 'LoginScreen'
+      : find.byType(ShellScreen).evaluate().isNotEmpty
+          ? 'ShellScreen'
+          : find.byType(CircularProgressIndicator).evaluate().isNotEmpty
+              ? 'Loading'
+              : 'Other';
+  final authUser = Supabase.instance.isInitialized &&
+      Supabase.instance.client.auth.currentUser != null;
+  return 'widget=$screen authUser=$authUser appSession=${AppSession.instance.authenticated}';
+}
