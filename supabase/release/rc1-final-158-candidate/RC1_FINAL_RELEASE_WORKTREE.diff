diff --git a/supabase/migrations/20261024190000_rc1_pilot_exports_and_asset_maintenance_disable.sql b/supabase/migrations/20261024190000_rc1_pilot_exports_and_asset_maintenance_disable.sql
new file mode 100644
index 0000000..9763559
--- /dev/null
+++ b/supabase/migrations/20261024190000_rc1_pilot_exports_and_asset_maintenance_disable.sql
@@ -0,0 +1,212 @@
+-- RC1 internal pilot: allow only the 14 R13-tested data exports.
+-- File downloads and sensitive-export modes are intentionally disabled.
+-- This migration is intended to run after the consolidated RC1-FINAL security candidate.
+
+DO $preflight$
+DECLARE
+  v_begin_md5 text;
+  v_dataset_md5 text;
+BEGIN
+  IF session_user <> 'postgres' OR current_user <> 'postgres' THEN
+    RAISE EXCEPTION 'RC1 pilot export migration requires the verified postgres migration identity';
+  END IF;
+
+  IF to_regprocedure('public.begin_club_export_v1(uuid,text[],boolean,boolean,text)') IS NULL
+     OR to_regprocedure('public.club_export_dataset_v1(uuid,uuid,text,integer,integer)') IS NULL
+     OR to_regprocedure('public.club_export_file_access_v1(text,text)') IS NULL THEN
+    RAISE EXCEPTION 'Reviewed R12 export functions are missing; refusing partial pilot setup';
+  END IF;
+
+  SELECT md5(p.prosrc) INTO v_begin_md5
+  FROM pg_proc p WHERE p.oid = 'public.begin_club_export_v1(uuid,text[],boolean,boolean,text)'::regprocedure;
+  SELECT md5(p.prosrc) INTO v_dataset_md5
+  FROM pg_proc p WHERE p.oid = 'public.club_export_dataset_v1(uuid,uuid,text,integer,integer)'::regprocedure;
+
+  IF v_begin_md5 <> '95598577549f54987493101cf0ca80c3'
+     OR v_dataset_md5 <> '11c1ec04f9abfbabc9bb164f2fa95664' THEN
+    RAISE EXCEPTION 'R12 export function definitions differ from the reviewed RC1-FINAL source';
+  END IF;
+
+  IF to_regprocedure('public.begin_club_export_v1_pilot_internal(uuid,text[],boolean,boolean,text)') IS NOT NULL
+     OR to_regprocedure('public.club_export_dataset_v1_pilot_internal(uuid,uuid,text,integer,integer)') IS NOT NULL THEN
+    RAISE EXCEPTION 'Pilot internal export function already exists; refusing ambiguous rename';
+  END IF;
+END
+$preflight$;
+
+ALTER FUNCTION public.begin_club_export_v1(uuid,text[],boolean,boolean,text)
+  RENAME TO begin_club_export_v1_pilot_internal;
+ALTER FUNCTION public.club_export_dataset_v1(uuid,uuid,text,integer,integer)
+  RENAME TO club_export_dataset_v1_pilot_internal;
+
+-- Internal helpers are callable only by their owner through the public pilot façade.
+REVOKE ALL ON FUNCTION public.begin_club_export_v1_pilot_internal(uuid,text[],boolean,boolean,text)
+  FROM PUBLIC, anon, authenticated, service_role;
+REVOKE ALL ON FUNCTION public.club_export_dataset_v1_pilot_internal(uuid,uuid,text,integer,integer)
+  FROM PUBLIC, anon, authenticated, service_role;
+
+CREATE FUNCTION public.begin_club_export_v1(
+  target_club uuid,
+  p_modules text[],
+  p_include_sensitive boolean DEFAULT false,
+  p_include_files boolean DEFAULT false,
+  p_manifest_version text DEFAULT 'bob-export-v1'
+)
+RETURNS uuid
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $pilot$
+DECLARE
+  v_modules text[];
+  v_allowed CONSTANT text[] := ARRAY['financial','fees','lottery']::text[];
+BEGIN
+  SELECT COALESCE(
+    array_agg(DISTINCT btrim(requested.module_key) ORDER BY btrim(requested.module_key)),
+    ARRAY[]::text[]
+  )
+  INTO v_modules
+  FROM unnest(COALESCE(p_modules, ARRAY[]::text[])) AS requested(module_key)
+  WHERE NULLIF(btrim(requested.module_key), '') IS NOT NULL;
+
+  IF cardinality(v_modules) = 0 THEN
+    RAISE EXCEPTION 'Seleciona uma das áreas de exportação disponíveis no piloto.' USING ERRCODE = '42501';
+  END IF;
+
+  IF EXISTS (
+    SELECT 1 FROM unnest(v_modules) AS requested(module_key)
+    WHERE NOT (requested.module_key = ANY(v_allowed))
+  ) THEN
+    RAISE EXCEPTION 'A área de exportação não está disponível no piloto.' USING ERRCODE = '42501';
+  END IF;
+
+  IF COALESCE(p_include_sensitive, false) OR COALESCE(p_include_files, false) THEN
+    RAISE EXCEPTION 'Exportação de dados sensíveis ou ficheiros está desativada no piloto.' USING ERRCODE = '42501';
+  END IF;
+
+  RETURN public.begin_club_export_v1_pilot_internal(
+    target_club, v_modules, false, false, p_manifest_version
+  );
+END
+$pilot$;
+
+CREATE FUNCTION public.club_export_dataset_v1(
+  target_club uuid,
+  p_export uuid,
+  p_dataset text,
+  p_offset integer DEFAULT 0,
+  p_limit integer DEFAULT 1000
+)
+RETURNS SETOF jsonb
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $pilot$
+DECLARE
+  v_allowed CONSTANT text[] := ARRAY[
+    'financeiro/pedidos.csv',
+    'financeiro/pedidos_anexos.csv',
+    'financeiro/documentos_movimentos.csv',
+    'quotas/planos.csv',
+    'quotas/obrigacoes.csv',
+    'quotas/pagamentos.csv',
+    'euromilhoes/participantes.csv',
+    'euromilhoes/sorteios.csv',
+    'euromilhoes/chaves.csv',
+    'euromilhoes/participacoes.csv',
+    'euromilhoes/resultados.csv',
+    'euromilhoes/cobrancas.csv',
+    'euromilhoes/multas.csv',
+    'euromilhoes/premios.csv'
+  ]::text[];
+BEGIN
+  IF p_dataset IS NULL OR NOT (p_dataset = ANY(v_allowed)) THEN
+    RAISE EXCEPTION 'Dataset de exportação não disponível no piloto.' USING ERRCODE = '42501';
+  END IF;
+
+  RETURN QUERY
+  SELECT *
+  FROM public.club_export_dataset_v1_pilot_internal(
+    target_club, p_export, p_dataset, p_offset, p_limit
+  );
+END
+$pilot$;
+
+REVOKE ALL ON FUNCTION public.begin_club_export_v1(uuid,text[],boolean,boolean,text)
+  FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION public.begin_club_export_v1(uuid,text[],boolean,boolean,text)
+  TO authenticated, service_role;
+REVOKE ALL ON FUNCTION public.club_export_dataset_v1(uuid,uuid,text,integer,integer)
+  FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION public.club_export_dataset_v1(uuid,uuid,text,integer,integer)
+  TO authenticated, service_role;
+
+-- The storage policy can continue invoking this helper, but it authorizes no
+-- export files in the pilot because file export has not been behaviorally tested.
+CREATE OR REPLACE FUNCTION public.club_export_file_access_v1(p_bucket text, p_name text)
+RETURNS boolean
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = pg_catalog
+AS $pilot$
+  SELECT false
+$pilot$;
+REVOKE ALL ON FUNCTION public.club_export_file_access_v1(text,text) FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION public.club_export_file_access_v1(text,text) TO authenticated, service_role;
+
+-- Keep any historical asset_maintenance_v1 definition intact, but prevent all
+-- API client and service roles from executing any overload. No invocation/drop.
+DO $disable_asset_maintenance$
+DECLARE
+  v_function oid;
+BEGIN
+  FOR v_function IN
+    SELECT p.oid
+    FROM pg_proc p
+    JOIN pg_namespace n ON n.oid = p.pronamespace
+    WHERE n.nspname = 'public' AND p.proname = 'asset_maintenance_v1'
+  LOOP
+    EXECUTE format(
+      'REVOKE ALL ON FUNCTION %s FROM PUBLIC, anon, authenticated, service_role',
+      v_function::regprocedure
+    );
+  END LOOP;
+END
+$disable_asset_maintenance$;
+
+DO $postflight$
+DECLARE
+  v_function oid;
+BEGIN
+  IF has_function_privilege('anon', 'public.begin_club_export_v1(uuid,text[],boolean,boolean,text)', 'EXECUTE')
+     OR has_function_privilege('anon', 'public.club_export_dataset_v1(uuid,uuid,text,integer,integer)', 'EXECUTE') THEN
+    RAISE EXCEPTION 'anon retains an export EXECUTE privilege';
+  END IF;
+
+  IF has_function_privilege('authenticated', 'public.begin_club_export_v1_pilot_internal(uuid,text[],boolean,boolean,text)', 'EXECUTE')
+     OR has_function_privilege('authenticated', 'public.club_export_dataset_v1_pilot_internal(uuid,uuid,text,integer,integer)', 'EXECUTE')
+     OR has_function_privilege('service_role', 'public.begin_club_export_v1_pilot_internal(uuid,text[],boolean,boolean,text)', 'EXECUTE')
+     OR has_function_privilege('service_role', 'public.club_export_dataset_v1_pilot_internal(uuid,uuid,text,integer,integer)', 'EXECUTE') THEN
+    RAISE EXCEPTION 'A client/service API role can execute an internal export function';
+  END IF;
+
+  IF has_function_privilege('authenticated', 'public.club_export_file_access_v1(text,text)', 'EXECUTE')
+     AND public.club_export_file_access_v1('financial-documents', 'pilot-probe') IS DISTINCT FROM false THEN
+    RAISE EXCEPTION 'Export file helper is not closed for the pilot';
+  END IF;
+
+  FOR v_function IN
+    SELECT p.oid
+    FROM pg_proc p
+    JOIN pg_namespace n ON n.oid = p.pronamespace
+    WHERE n.nspname = 'public' AND p.proname = 'asset_maintenance_v1'
+  LOOP
+    IF has_function_privilege('anon', v_function, 'EXECUTE')
+       OR has_function_privilege('authenticated', v_function, 'EXECUTE')
+       OR has_function_privilege('service_role', v_function, 'EXECUTE') THEN
+      RAISE EXCEPTION 'asset_maintenance_v1 remains executable by an API role';
+    END IF;
+  END LOOP;
+END
+$postflight$;
diff --git a/supabase/migrations/20261027195243_rc1_bar_inventory_sales_integrity.sql b/supabase/migrations/20261027195243_rc1_bar_inventory_sales_integrity.sql
new file mode 100644
index 0000000..46ec8ae
--- /dev/null
+++ b/supabase/migrations/20261027195243_rc1_bar_inventory_sales_integrity.sql
@@ -0,0 +1,245 @@
+-- Bar/Inventory stock and sales integrity hardening.
+-- Keeps non-Bar sellInventory sales while requiring manageBar for Bar products.
+
+create or replace function public.inventory_operation_v1(
+  target_club uuid,
+  p_product uuid,
+  p_operation text,
+  p_quantity numeric,
+  p_unit_price numeric default null,
+  p_description text default null,
+  p_payment_method text default null
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $function$
+declare
+  v_product public.products%rowtype;
+  v_new_stock numeric;
+  v_new_reserved numeric;
+  v_account uuid;
+  v_cost_center uuid;
+  v_transaction uuid;
+  v_kind public.stock_movement_kind;
+  v_total numeric;
+begin
+  if p_operation = 'sale' then
+    if not public.has_club_permission(target_club, 'sellInventory') then
+      raise exception 'Sem autorização para registar vendas.' using errcode = '42501';
+    end if;
+  elsif not public.has_club_permission(target_club, 'manageInventory') then
+    raise exception 'Sem autorização para gerir inventário.' using errcode = '42501';
+  end if;
+
+  if p_quantity <= 0 then
+    raise exception 'A quantidade deve ser superior a zero.';
+  end if;
+
+  select * into v_product
+  from public.products
+  where id = p_product
+    and club_id = target_club
+    and active = true
+  for update;
+
+  if not found then
+    raise exception 'Artigo não encontrado ou inativo.';
+  end if;
+
+  -- Inventory sales remain available for non-Bar stock. Bar stock must pass
+  -- through an actor with the effective Bar permission.
+  if p_operation = 'sale'
+     and v_product.inventory_area = 'bar'
+     and not public.has_club_permission(target_club, 'manageBar') then
+    raise exception 'A venda de artigos do Bar requer a permissão manageBar.'
+      using errcode = '42501';
+  end if;
+
+  v_new_stock := v_product.current_stock;
+  v_new_reserved := v_product.reserved_stock;
+
+  if p_operation = 'entry' then
+    v_new_stock := v_new_stock + p_quantity;
+    v_kind := 'purchase';
+  elsif p_operation = 'adjustment_in' then
+    v_new_stock := v_new_stock + p_quantity;
+    v_kind := 'adjustment';
+  elsif p_operation = 'adjustment_out' then
+    v_new_stock := v_new_stock - p_quantity;
+    v_kind := 'adjustment';
+  elsif p_operation = 'reserve' then
+    if v_new_stock - v_new_reserved < p_quantity then
+      raise exception 'Stock disponível insuficiente para a reserva.';
+    end if;
+    v_new_reserved := v_new_reserved + p_quantity;
+    v_kind := 'transfer';
+  elsif p_operation = 'release' then
+    if v_new_reserved < p_quantity then
+      raise exception 'Reserva insuficiente.';
+    end if;
+    v_new_reserved := v_new_reserved - p_quantity;
+    v_kind := 'return';
+  elsif p_operation = 'sale' then
+    if v_new_stock - v_new_reserved < p_quantity then
+      raise exception 'Stock disponível insuficiente para a venda.';
+    end if;
+    v_new_stock := v_new_stock - p_quantity;
+    v_kind := 'sale';
+  else
+    raise exception 'Operação de inventário inválida.';
+  end if;
+
+  if v_new_stock < 0
+      or v_new_reserved < 0
+      or v_new_reserved > v_new_stock then
+    raise exception 'O stock não pode ficar negativo nem abaixo do stock reservado.';
+  end if;
+
+  update public.products
+  set current_stock = v_new_stock,
+      reserved_stock = v_new_reserved
+  where id = v_product.id;
+
+  insert into public.stock_movements (
+    club_id, product_id, kind, quantity, unit_cost, notes, created_by
+  )
+  values (
+    target_club,
+    v_product.id,
+    v_kind,
+    case
+      when p_operation in ('adjustment_out', 'sale') then -p_quantity
+      else p_quantity
+    end,
+    coalesce(p_unit_price, v_product.cost),
+    nullif(trim(coalesce(p_description, '')), ''),
+    auth.uid()
+  );
+
+  if p_operation = 'sale' then
+    v_total := p_quantity * coalesce(p_unit_price, v_product.sale_price);
+
+    select id into v_account
+    from public.treasury_accounts
+    where club_id = target_club
+      and active = true
+      and lower(name) = lower('Club House')
+    limit 1;
+
+    if v_account is null then
+      raise exception 'Conta Club House não encontrada.';
+    end if;
+
+    select id into v_cost_center
+    from public.cost_centers
+    where club_id = target_club
+      and active = true
+      and lower(name) = lower('Club House')
+    limit 1;
+
+    insert into public.treasury_transactions (
+      club_id, kind, account_id, cost_center_id, transaction_date,
+      description, amount, payment_method, source_type, source_id, created_by
+    )
+    values (
+      target_club,
+      'income',
+      v_account,
+      v_cost_center,
+      current_date,
+      coalesce(
+        nullif(trim(coalesce(p_description, '')), ''),
+        'Venda ' || v_product.name
+      ),
+      v_total,
+      p_payment_method,
+      'inventory_sale',
+      v_product.id,
+      auth.uid()
+    )
+    returning id into v_transaction;
+  end if;
+
+  return jsonb_build_object(
+    'product_id', v_product.id,
+    'current_stock', v_new_stock,
+    'reserved_stock', v_new_reserved,
+    'transaction_id', v_transaction
+  );
+end;
+$function$;
+
+-- RLS policies are permissive by default and combine with OR. These restrictive
+-- policies AND with every permissive policy, so no client can mutate the stock
+-- ledger directly. Real application writes use SECURITY DEFINER RPCs owned by
+-- the table owner; RLS is enabled but not FORCE-enabled on this table.
+drop policy if exists stock_movements_no_client_sale_insert_v1
+  on public.stock_movements;
+drop policy if exists stock_movements_no_direct_insert_v1
+  on public.stock_movements;
+drop policy if exists stock_movements_no_direct_update_v1
+  on public.stock_movements;
+drop policy if exists stock_movements_no_direct_delete_v1
+  on public.stock_movements;
+create policy stock_movements_no_direct_insert_v1
+  on public.stock_movements as restrictive
+  for insert to authenticated
+  with check (false);
+create policy stock_movements_no_direct_update_v1
+  on public.stock_movements as restrictive
+  for update to authenticated
+  using (false)
+  with check (false);
+create policy stock_movements_no_direct_delete_v1
+  on public.stock_movements as restrictive
+  for delete to authenticated
+  using (false);
+
+-- Deleting a product cascades into stock_movements and Bar operation history.
+-- The real client archives products; privileged import rollback remains a
+-- SECURITY DEFINER path owned by the table owner and is unaffected because
+-- FORCE ROW LEVEL SECURITY is not enabled on products.
+drop policy if exists products_no_client_delete_v1 on public.products;
+create policy products_no_client_delete_v1
+  on public.products as restrictive
+  for delete to authenticated
+  using (false);
+
+-- Clients may edit product metadata, but stock totals must only be changed by
+-- the table owner's checked SECURITY DEFINER operations (Bar, Inventory,
+-- inventory counts and reversals), not by direct PostgREST UPDATE.
+create or replace function bob_dinner_private.guard_products_stock_write_v1()
+returns trigger
+language plpgsql
+security invoker
+set search_path = pg_catalog
+as $function$
+declare
+  v_owner name;
+begin
+  if new.current_stock is distinct from old.current_stock
+     or new.reserved_stock is distinct from old.reserved_stock then
+    select r.rolname into v_owner
+    from pg_catalog.pg_class c
+    join pg_catalog.pg_roles r on r.oid = c.relowner
+    where c.oid = 'public.products'::regclass;
+
+    if v_owner is null or current_user <> v_owner then
+      raise exception 'O stock só pode ser alterado por operações autorizadas de Bar/Inventário.'
+        using errcode = '42501';
+    end if;
+  end if;
+  return new;
+end;
+$function$;
+
+revoke all on function bob_dinner_private.guard_products_stock_write_v1()
+  from public, anon, authenticated;
+
+drop trigger if exists trg_guard_products_stock_write_v1 on public.products;
+create trigger trg_guard_products_stock_write_v1
+  before update of current_stock, reserved_stock on public.products
+  for each row execute function bob_dinner_private.guard_products_stock_write_v1();
+
diff --git a/supabase/migrations/20261027210000_rc1_bar_sales_dml_guard.sql b/supabase/migrations/20261027210000_rc1_bar_sales_dml_guard.sql
new file mode 100644
index 0000000..77bfebf
--- /dev/null
+++ b/supabase/migrations/20261027210000_rc1_bar_sales_dml_guard.sql
@@ -0,0 +1,118 @@
+-- BOB Manager RC1 — R5 focused Bar sales write boundary
+-- Evidence source: R5 HTTP reproduction on isolated local R3, 2026-10-27.
+-- Scope: public.bar_sales, public.bar_sale_items, public.bar_operations only.
+-- Keeps the existing authenticated PATCH draft -> cancelled path; all other
+-- application writes continue through the existing owner-controlled RPCs.
+BEGIN;
+
+-- Direct table DML is not used by the real-mode sale/item/operation paths.
+-- `bar_sales` UPDATE remains for the existing cancelDraft() PATCH only.
+REVOKE INSERT, DELETE ON TABLE public.bar_sales FROM authenticated;
+REVOKE INSERT, UPDATE, DELETE ON TABLE public.bar_sale_items FROM authenticated;
+REVOKE INSERT, UPDATE, DELETE ON TABLE public.bar_operations FROM authenticated;
+-- anon had explicit SELECT/INSERT/UPDATE/DELETE table rights on bar_operations;
+-- there is no anonymous Bar workflow or matching anonymous row policy.
+REVOKE ALL PRIVILEGES ON TABLE public.bar_operations FROM anon;
+
+-- RLS defense in depth: later permissive policies/grants cannot reopen these
+-- direct write paths for client roles. PostgreSQL combines restrictive policies
+-- with permissive policies using AND.
+DROP POLICY IF EXISTS r5_bar_sales_insert_rpc_only ON public.bar_sales;
+CREATE POLICY r5_bar_sales_insert_rpc_only
+  ON public.bar_sales AS RESTRICTIVE FOR INSERT TO anon, authenticated
+  WITH CHECK (false);
+
+DROP POLICY IF EXISTS r5_bar_sales_update_cancel_draft_only ON public.bar_sales;
+CREATE POLICY r5_bar_sales_update_cancel_draft_only
+  ON public.bar_sales AS RESTRICTIVE FOR UPDATE TO anon, authenticated
+  USING (status = 'draft')
+  WITH CHECK (status = 'cancelled');
+
+DROP POLICY IF EXISTS r5_bar_sales_delete_rpc_only ON public.bar_sales;
+CREATE POLICY r5_bar_sales_delete_rpc_only
+  ON public.bar_sales AS RESTRICTIVE FOR DELETE TO anon, authenticated
+  USING (false);
+
+DROP POLICY IF EXISTS r5_bar_sale_items_insert_rpc_only ON public.bar_sale_items;
+CREATE POLICY r5_bar_sale_items_insert_rpc_only
+  ON public.bar_sale_items AS RESTRICTIVE FOR INSERT TO anon, authenticated
+  WITH CHECK (false);
+
+DROP POLICY IF EXISTS r5_bar_sale_items_update_rpc_only ON public.bar_sale_items;
+CREATE POLICY r5_bar_sale_items_update_rpc_only
+  ON public.bar_sale_items AS RESTRICTIVE FOR UPDATE TO anon, authenticated
+  USING (false) WITH CHECK (false);
+
+DROP POLICY IF EXISTS r5_bar_sale_items_delete_rpc_only ON public.bar_sale_items;
+CREATE POLICY r5_bar_sale_items_delete_rpc_only
+  ON public.bar_sale_items AS RESTRICTIVE FOR DELETE TO anon, authenticated
+  USING (false);
+
+DROP POLICY IF EXISTS r5_bar_operations_insert_rpc_only ON public.bar_operations;
+CREATE POLICY r5_bar_operations_insert_rpc_only
+  ON public.bar_operations AS RESTRICTIVE FOR INSERT TO anon, authenticated
+  WITH CHECK (false);
+
+DROP POLICY IF EXISTS r5_bar_operations_update_rpc_only ON public.bar_operations;
+CREATE POLICY r5_bar_operations_update_rpc_only
+  ON public.bar_operations AS RESTRICTIVE FOR UPDATE TO anon, authenticated
+  USING (false) WITH CHECK (false);
+
+DROP POLICY IF EXISTS r5_bar_operations_delete_rpc_only ON public.bar_operations;
+CREATE POLICY r5_bar_operations_delete_rpc_only
+  ON public.bar_operations AS RESTRICTIVE FOR DELETE TO anon, authenticated
+  USING (false);
+
+-- Preserve the current real client cancelDraft() operation, but make its only
+-- permitted direct UPDATE exactly draft -> cancelled with no business-field
+-- edits, club reassignment, or attribution forgery. SECDEF RPC writes execute
+-- as their trusted owner and retain the established sale/reversal workflows.
+CREATE OR REPLACE FUNCTION bob_dinner_private.guard_authenticated_bar_sale_draft_cancel()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY INVOKER
+SET search_path = pg_catalog
+AS $r5$
+BEGIN
+  IF current_user = 'anon' THEN
+    RAISE EXCEPTION 'A sessão é necessária para alterar uma venda.'
+      USING ERRCODE = '42501';
+  END IF;
+
+  IF current_user <> 'authenticated' THEN
+    RETURN NEW;
+  END IF;
+
+  IF OLD.status IS DISTINCT FROM 'draft'
+     OR NEW.status IS DISTINCT FROM 'cancelled' THEN
+    RAISE EXCEPTION 'A escrita direta só pode cancelar um rascunho.'
+      USING ERRCODE = '42501';
+  END IF;
+
+  IF (pg_catalog.to_jsonb(NEW) - ARRAY['status','updated_by','updated_at'])
+       IS DISTINCT FROM
+     (pg_catalog.to_jsonb(OLD) - ARRAY['status','updated_by','updated_at']) THEN
+    RAISE EXCEPTION 'O cancelamento direto não pode alterar os dados da venda.'
+      USING ERRCODE = '42501';
+  END IF;
+
+  IF NEW.club_id IS DISTINCT FROM OLD.club_id
+     OR NEW.updated_by IS DISTINCT FROM auth.uid() THEN
+    RAISE EXCEPTION 'O clube e o autor do rascunho não podem ser alterados.'
+      USING ERRCODE = '42501';
+  END IF;
+
+  RETURN NEW;
+END;
+$r5$;
+
+REVOKE ALL ON FUNCTION bob_dinner_private.guard_authenticated_bar_sale_draft_cancel()
+  FROM PUBLIC, anon, authenticated;
+
+DROP TRIGGER IF EXISTS trg_r5_bar_sales_draft_cancel_guard ON public.bar_sales;
+CREATE TRIGGER trg_r5_bar_sales_draft_cancel_guard
+  BEFORE UPDATE ON public.bar_sales
+  FOR EACH ROW
+  EXECUTE FUNCTION bob_dinner_private.guard_authenticated_bar_sale_draft_cancel();
+
+COMMIT;
diff --git a/supabase/tests/rc1_pilot_export_asset_acl.sql b/supabase/tests/rc1_pilot_export_asset_acl.sql
new file mode 100644
index 0000000..292cecb
--- /dev/null
+++ b/supabase/tests/rc1_pilot_export_asset_acl.sql
@@ -0,0 +1,136 @@
+-- Run after the RC1 consolidated security candidate and the pilot scope migration.
+-- All checks below are catalog-only or use denied calls that write no rows.
+BEGIN;
+
+DO $catalog_assertions$
+DECLARE
+  v_fn oid;
+  v_source text;
+  v_expected text[] := ARRAY[
+    'financeiro/pedidos.csv',
+    'financeiro/pedidos_anexos.csv',
+    'financeiro/documentos_movimentos.csv',
+    'quotas/planos.csv',
+    'quotas/obrigacoes.csv',
+    'quotas/pagamentos.csv',
+    'euromilhoes/participantes.csv',
+    'euromilhoes/sorteios.csv',
+    'euromilhoes/chaves.csv',
+    'euromilhoes/participacoes.csv',
+    'euromilhoes/resultados.csv',
+    'euromilhoes/cobrancas.csv',
+    'euromilhoes/multas.csv',
+    'euromilhoes/premios.csv'
+  ];
+  v_path text;
+BEGIN
+  IF NOT has_function_privilege('authenticated', 'public.begin_club_export_v1(uuid,text[],boolean,boolean,text)', 'EXECUTE')
+     OR has_function_privilege('anon', 'public.begin_club_export_v1(uuid,text[],boolean,boolean,text)', 'EXECUTE') THEN
+    RAISE EXCEPTION 'Pilot begin RPC grants are incorrect';
+  END IF;
+  IF NOT has_function_privilege('authenticated', 'public.club_export_dataset_v1(uuid,uuid,text,integer,integer)', 'EXECUTE')
+     OR has_function_privilege('anon', 'public.club_export_dataset_v1(uuid,uuid,text,integer,integer)', 'EXECUTE') THEN
+    RAISE EXCEPTION 'Pilot dataset RPC grants are incorrect';
+  END IF;
+
+  IF has_function_privilege('authenticated', 'public.begin_club_export_v1_pilot_internal(uuid,text[],boolean,boolean,text)', 'EXECUTE')
+     OR has_function_privilege('anon', 'public.begin_club_export_v1_pilot_internal(uuid,text[],boolean,boolean,text)', 'EXECUTE')
+     OR has_function_privilege('service_role', 'public.begin_club_export_v1_pilot_internal(uuid,text[],boolean,boolean,text)', 'EXECUTE')
+     OR has_function_privilege('authenticated', 'public.club_export_dataset_v1_pilot_internal(uuid,uuid,text,integer,integer)', 'EXECUTE')
+     OR has_function_privilege('anon', 'public.club_export_dataset_v1_pilot_internal(uuid,uuid,text,integer,integer)', 'EXECUTE')
+     OR has_function_privilege('service_role', 'public.club_export_dataset_v1_pilot_internal(uuid,uuid,text,integer,integer)', 'EXECUTE') THEN
+    RAISE EXCEPTION 'An internal export helper remains executable by an API role';
+  END IF;
+
+  SELECT p.oid, p.prosrc INTO v_fn, v_source
+  FROM pg_proc p
+  WHERE p.oid = 'public.club_export_dataset_v1(uuid,uuid,text,integer,integer)'::regprocedure;
+  FOREACH v_path IN ARRAY v_expected LOOP
+    IF position(v_path IN v_source) = 0 THEN
+      RAISE EXCEPTION 'Pilot server allowlist is missing %', v_path;
+    END IF;
+  END LOOP;
+  IF position('membros/membros.csv' IN v_source) > 0
+     OR position('inventario/produtos.csv' IN v_source) > 0
+     OR position('tesouraria/movimentos.csv' IN v_source) > 0 THEN
+    RAISE EXCEPTION 'An unapproved dataset appears in the public pilot façade';
+  END IF;
+
+  IF has_function_privilege('anon', v_fn, 'EXECUTE') THEN
+    RAISE EXCEPTION 'anon can execute pilot dataset RPC';
+  END IF;
+
+  IF public.club_export_file_access_v1('financial-documents', 'pilot-probe') IS DISTINCT FROM false THEN
+    RAISE EXCEPTION 'Export file access is not disabled';
+  END IF;
+
+  IF EXISTS (
+    SELECT 1
+    FROM pg_proc p
+    JOIN pg_namespace n ON n.oid = p.pronamespace
+    WHERE n.nspname = 'public' AND p.proname = 'asset_maintenance_v1'
+      AND (
+        has_function_privilege('anon', p.oid, 'EXECUTE')
+        OR has_function_privilege('authenticated', p.oid, 'EXECUTE')
+        OR has_function_privilege('service_role', p.oid, 'EXECUTE')
+      )
+  ) THEN
+    RAISE EXCEPTION 'asset_maintenance_v1 is still executable by an API role';
+  END IF;
+END
+$catalog_assertions$;
+
+SET LOCAL ROLE authenticated;
+SELECT set_config('request.jwt.claim.sub', '22000000-0000-0000-0000-000000000099', true);
+SELECT set_config('request.jwt.claims', '{"sub":"22000000-0000-0000-0000-000000000099","role":"authenticated"}', true);
+
+DO $api_negative_calls$
+DECLARE
+  v_state text;
+BEGIN
+  BEGIN
+    PERFORM public.begin_club_export_v1(
+      '22000000-0000-0000-0000-000000000001', ARRAY['members'], false, false, 'pilot-test'
+    );
+    RAISE EXCEPTION 'Expected unsupported section denial';
+  EXCEPTION WHEN insufficient_privilege THEN
+    GET STACKED DIAGNOSTICS v_state = RETURNED_SQLSTATE;
+    IF v_state <> '42501' THEN RAISE; END IF;
+  END;
+
+  BEGIN
+    PERFORM public.begin_club_export_v1(
+      '22000000-0000-0000-0000-000000000001', ARRAY['fees'], false, true, 'pilot-test'
+    );
+    RAISE EXCEPTION 'Expected file export denial';
+  EXCEPTION WHEN insufficient_privilege THEN
+    GET STACKED DIAGNOSTICS v_state = RETURNED_SQLSTATE;
+    IF v_state <> '42501' THEN RAISE; END IF;
+  END;
+
+  BEGIN
+    PERFORM public.begin_club_export_v1(
+      '22000000-0000-0000-0000-000000000001', ARRAY['fees'], true, false, 'pilot-test'
+    );
+    RAISE EXCEPTION 'Expected sensitive export denial';
+  EXCEPTION WHEN insufficient_privilege THEN
+    GET STACKED DIAGNOSTICS v_state = RETURNED_SQLSTATE;
+    IF v_state <> '42501' THEN RAISE; END IF;
+  END;
+
+  BEGIN
+    PERFORM public.club_export_dataset_v1(
+      '22000000-0000-0000-0000-000000000001',
+      '22000000-0000-0000-0000-000000000099',
+      'membros/membros.csv', 0, 10
+    );
+    RAISE EXCEPTION 'Expected unapproved dataset denial';
+  EXCEPTION WHEN insufficient_privilege THEN
+    GET STACKED DIAGNOSTICS v_state = RETURNED_SQLSTATE;
+    IF v_state <> '42501' THEN RAISE; END IF;
+  END;
+END
+$api_negative_calls$;
+
+RESET ROLE;
+ROLLBACK;
