+    switch (_case) {
+      case 'member-clean':
+        await _login(tester, 'rc1-r3-member-a@local.invalid', trace);
+        await _assertMemberRestrictions(tester, client);
+        await _logout(tester, client);
+        break;
+      case 'president-member-swap':
+        await _login(tester, 'rc1-r3-president-a@local.invalid', trace);
+        expect(find.byType(ShellScreen), findsOneWidget);
+        expect(AppSession.instance.can(AppPermission.viewTreasury), isTrue);
+        final postsBeforeMember = _authPostCount(trace);
+        await _logout(tester, client);
+        expect(AppSession.instance.authenticated, isFalse);
+        expect(client.auth.currentUser, isNull);
+        debugPrint(
+          '[R6.9] step=post-logout session=false appSession=false '
+          'authPosts=$postsBeforeMember',
+        );
+        await _login(tester, 'rc1-r3-member-a@local.invalid', trace);
+        expect(_authPostCount(trace), postsBeforeMember + 1,
+            reason: 'Second login must send one new Auth token request.');
+        await _assertMemberRestrictions(tester, client);
+        await _logout(tester, client);
+        break;
+      case 'rejected-inactive':
+        await _loginRejected(
+          tester,
+          'rc1-r3-inactive-a@local.invalid',
+          trace,
+        );
+        break;
+      case 'rejected-no-club':
+        await _loginRejected(
+          tester,
+          'rc1-r3-no-club@local.invalid',
+          trace,
+        );
+        break;
+      case 'asset-ui':
+        await _login(tester, 'rc1-r3-admin-a@local.invalid', trace);
+        await _selectModule(tester, 'Património & Inventário');
+        await _pumpUntil(tester, find.text('Património & Inventário'));
+        await tester.tap(find.text('Operações'));
+        await _pumpUntil(tester, find.text('Empréstimos'));
+        await tester.tap(find.text('Manutenção'));
+        await _pumpUntil(
+          tester,
+          find.text('Registo de intervenções desativado no piloto.'),
+        );
+        expect(find.text('O histórico permanece disponível para consulta.'),
+            findsOneWidget);
+        expect(find.text('Nova manutenção'), findsNothing);
+        expect(find.text('Registar intervenção'), findsNothing);
+        expect(
+          trace.events
+              .any((event) => event.contains('/rpc/asset_maintenance_v1')),
+          isFalse,
+        );
+        debugPrint('[R6.9] asset-maintenance-ui=disabled no-rpc-invoked');
+        await _logout(tester, client);
+        break;
+    }
+
+    debugPrint(
+      '[R6.9] case=$_case result=PASS authPosts=${_authPostCount(trace)} '
+      'session=${client.auth.currentUser != null} '
+      'appSession=${AppSession.instance.authenticated}',
+    );
+  });
+}
+
+bool _clearR3PersistedAuthSession() {
+  final storage = globalContext.getProperty<JSObject?>('localStorage'.toJS);
+  if (storage == null) throw StateError('Browser localStorage unavailable.');
+  final prefix = Uri.parse(AppConfig.supabaseUrl).host.split('.').first;
+  final key = 'sb-$prefix-auth-token';
+  final previous = storage.callMethod<JSString?>('getItem'.toJS, key.toJS);
+  storage.callMethod<JSAny?>('removeItem'.toJS, key.toJS);
+  if (storage.callMethod<JSString?>('getItem'.toJS, key.toJS) != null) {
+    throw StateError('Prior local Auth state could not be cleared.');
+  }
+  return previous != null && previous.toDart.isNotEmpty;
+}
+
+int _authPostCount(SanitizedHttpTraceClient trace) => trace.events
+    .where((event) => event.contains('method=POST path=/auth/v1/token'))
+    .length;
+
+Future<void> _login(
+  WidgetTester tester,
+  String email,
+  SanitizedHttpTraceClient trace,
+) async {
+  await _pumpUntil(tester, find.byType(LoginScreen));
+  final fields = find.byType(TextField);
+  expect(fields, findsNWidgets(2));
+  await tester.enterText(fields.at(0), email);
+  await tester.enterText(fields.at(1), _password);
+  final emailFilled =
+      tester.widget<TextField>(fields.at(0)).controller?.text == email;
+  final passwordFilled =
+      tester.widget<TextField>(fields.at(1)).controller?.text == _password;
+  final button = tester.widget<FilledButton>(
+    find.widgetWithText(FilledButton, 'Entrar'),
+  );
+  final buttonEnabled = button.onPressed != null;
+  debugPrint(
+    '[R6.9] step=credentials-verified emailFilled=$emailFilled '
+    'passwordFilled=$passwordFilled buttonEnabled=$buttonEnabled '
+    'authUser=${Supabase.instance.client.auth.currentUser != null} '
+    'appSession=${AppSession.instance.authenticated}',
+  );
+  expect(emailFilled, isTrue);
+  expect(passwordFilled, isTrue);
+  expect(buttonEnabled, isTrue);
+
+  await tester.tap(find.widgetWithText(FilledButton, 'Entrar'));
+  debugPrint('[R6.9] step=login-button-tapped');
+  final end = DateTime.now().add(const Duration(seconds: 40));
+  var loadingObserved = false;
+  while (DateTime.now().isBefore(end)) {
+    loadingObserved = loadingObserved ||
+        find
+            .descendant(
+              of: find.byType(LoginScreen),
+              matching: find.byType(CircularProgressIndicator),
+            )
+            .evaluate()
+            .isNotEmpty;
+    if (find.byType(ShellScreen).evaluate().isNotEmpty) {
+      debugPrint(
+        '[R6.9] step=shell-reached loadingObserved=$loadingObserved '
+        'authPosts=${_authPostCount(trace)} authUser=true appSession=true',
+      );
+      return;
+    }
+    await tester.pump(const Duration(milliseconds: 100));
+  }
+
+  final errorVisible = _loginErrorVisible(tester);
+  debugPrint(
+    '[R6.9] step=login-timeout screen=${_screen(tester)} '
+    'loadingObserved=$loadingObserved errorVisible=$errorVisible '
+    'authPosts=${_authPostCount(trace)} '
+    'authUser=${Supabase.instance.client.auth.currentUser != null} '
+    'appSession=${AppSession.instance.authenticated}',
+  );
+  throw TestFailure(
+      'Login did not reach ShellScreen; screen=${_screen(tester)}');
+}
+
+Future<void> _loginRejected(
+  WidgetTester tester,
+  String email,
+  SanitizedHttpTraceClient trace,
+) async {
+  final fields = find.byType(TextField);
+  await tester.enterText(fields.at(0), email);
+  await tester.enterText(fields.at(1), _password);
+  expect(tester.widget<TextField>(fields.at(0)).controller?.text, email);
+  expect(tester.widget<TextField>(fields.at(1)).controller?.text, _password);
+  final button = tester.widget<FilledButton>(
+    find.widgetWithText(FilledButton, 'Entrar'),
+  );
+  expect(button.onPressed, isNotNull);
+  await tester.tap(find.widgetWithText(FilledButton, 'Entrar'));
+  debugPrint('[R6.9] step=rejected-login-button-tapped');
+  final end = DateTime.now().add(const Duration(seconds: 30));
+  while (DateTime.now().isBefore(end)) {
+    if (find.byType(LoginScreen).evaluate().isNotEmpty &&
+        clientUserIsNull() &&
+        !AppSession.instance.authenticated &&
+        _loginErrorVisible(tester)) {
+      break;
+    }
+    await tester.pump(const Duration(milliseconds: 100));
+  }
+  expect(find.byType(LoginScreen), findsOneWidget);
+  expect(_loginErrorVisible(tester), isTrue);
+  expect(clientUserIsNull(), isTrue);
+  expect(AppSession.instance.authenticated, isFalse);
+  expect(_authPostCount(trace), greaterThan(0));
+  debugPrint(
+    '[R6.9] rejected-account=PASS authPosts=${_authPostCount(trace)} '
+    'session=false appSession=false',
+  );
+}
+
+bool clientUserIsNull() => Supabase.instance.client.auth.currentUser == null;
+
+bool _loginErrorVisible(WidgetTester tester) {
+  final screen = find.byType(LoginScreen);
+  if (screen.evaluate().isEmpty) return false;
+  final errorColor = Theme.of(tester.element(screen)).colorScheme.error;
+  return find
+      .descendant(of: screen, matching: find.byType(Text))
+      .evaluate()
+      .any((element) {
+    final widget = element.widget;
+    return widget is Text && widget.style?.color == errorColor;
+  });
+}
+
+Future<void> _assertMemberRestrictions(
+  WidgetTester tester,
+  SupabaseClient client,
+) async {
+  expect(find.byType(ShellScreen), findsOneWidget);
+  expect(AppSession.instance.authenticated, isTrue);
+  expect(AppSession.instance.clubId, _clubA);
+  expect(AppSession.instance.can(AppPermission.viewTreasury), isFalse);
+  expect(
+    find.byType(NavigationDrawerDestination).evaluate().any((element) {
+      final widget = element.widget;
+      return widget is NavigationDrawerDestination &&
+          widget.label is Text &&
+          (widget.label as Text).data == 'Tesouraria';
+    }),
+    isFalse,
+  );
+  expect(
+    await client
+        .from('v_financial_balances')
+        .select('club_id,balance')
+        .eq('club_id', _clubA),
+    isEmpty,
+  );
+  expect(
+    await client
+        .from('financial_accounts')
+        .select('id,club_id')
+        .eq('club_id', _clubA),
+    isEmpty,
+  );
+  expect(
+    await client
+        .from('financial_transactions')
+        .select('id,club_id')
+        .eq('club_id', _clubA),
+    isEmpty,
+  );
+  await expectLater(
+    ClubExportService().generate(
+      sections: const {ClubExportSection.financial},
+      includeSensitive: false,
+      includeFiles: false,
+    ),
+    throwsA(isA<ClubExportFailure>()),
+  );
+  await expectLater(
+    client.rpc('begin_club_export_v1', params: {
+      'target_club': _clubA,
+      'p_modules': ['financial'],
+      'p_include_sensitive': false,
+      'p_include_files': false,
+      'p_manifest_version': 'bob-export-v1',
+    }),
+    throwsA(isA<PostgrestException>()),
+  );
+  await _selectModule(tester, 'Agenda');
+  await _pumpUntil(tester, find.byType(AgendaScreen));
+  expect(
+    await client.from('agenda_items').select('id').eq('id', _agendaItemA),
+    isEmpty,
+  );
+  debugPrint('[R6.9] member-negative-finance-export-agenda=PASS');
+}
+
+Future<void> _logout(WidgetTester tester, SupabaseClient client) async {
+  final logout = find.text('Terminar sessão').first;
+  await tester.ensureVisible(logout);
+  await tester.tap(logout);
+  await _pumpUntil(tester, find.byType(LoginScreen));
+  expect(client.auth.currentUser, isNull);
+  expect(AppSession.instance.authenticated, isFalse);
+  debugPrint('[R6.9] step=logout-complete session=false appSession=false');
+}
+
+Future<void> _selectModule(WidgetTester tester, String title) async {
+  final destination = find.widgetWithText(NavigationDrawerDestination, title);
+  if (destination.evaluate().isNotEmpty) {
+    await tester.ensureVisible(destination);
+    await tester.tap(destination);
+    await tester.pump(const Duration(milliseconds: 700));
+    return;
+  }
+  final label = find.text(title);
+  if (label.evaluate().isNotEmpty) {
+    await tester.ensureVisible(label.first);
+    await tester.tap(label.first);
+    await tester.pump(const Duration(milliseconds: 700));
+    return;
+  }
+  throw TestFailure('Authorized module unavailable: $title');
+}
+
+Future<void> _pumpUntil(WidgetTester tester, Finder finder) async {
+  final end = DateTime.now().add(const Duration(seconds: 35));
+  while (DateTime.now().isBefore(end)) {
+    if (finder.evaluate().isNotEmpty) return;
+    await tester.pump(const Duration(milliseconds: 100));
+  }
+  throw TestFailure('Timed out waiting for $finder; screen=${_screen(tester)}');
+}
+
+String _screen(WidgetTester tester) {
+  if (find.byType(LoginScreen).evaluate().isNotEmpty) return 'LoginScreen';
+  if (find.byType(ShellScreen).evaluate().isNotEmpty) return 'ShellScreen';
+  return 'Other';
+}
