+++ b/apps/mobile/test/shell_module_visibility_test.dart
@@ -0,0 +1,277 @@
+import 'package:bob_manager_mobile/core/app_session.dart';
+import 'package:bob_manager_mobile/core/module_definition.dart';
+import 'package:bob_manager_mobile/core/permissions.dart';
+import 'package:bob_manager_mobile/screens/bar_screen_v4.dart';
+import 'package:bob_manager_mobile/screens/inventory_module_screen.dart';
+import 'package:bob_manager_mobile/screens/shell_screen.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+const _authenticatedBase = [
+  'Dashboard',
+  'Atividade',
+  'Pedidos & Pagamentos',
+  'Oficial da Semana',
+  'Agenda',
+];
+const _barInventoryExpected = [
+  ..._authenticatedBase,
+  'BAR',
+  'Património & Inventário'
+];
+const _memberExpected = [..._authenticatedBase, 'Membros'];
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  tearDown(() => AppSession.instance.clear());
+
+  testWidgets(
+      'Direção com permissões efetivas vê todos os módulos em desktop, tablet e mobile',
+      (tester) async {
+    _authenticateWith(
+      AppPermission.values.map((permission) => permission.key),
+      role: 'president',
+    );
+
+    await _pumpAt(tester, const Size(1600, 1000));
+    await _expectDrawerModules(
+        tester, appModules.map((module) => module.title));
+    expect(tester.takeException(), isNull);
+
+    await _pumpAt(tester, const Size(800, 1000));
+    final tabletPrimary = _railLabels(tester);
+    expect(tabletPrimary, contains('Mais'));
+    await tester.tap(_railMore);
+    await tester.pumpAndSettle();
+    await _expectAllInMoreSheet(
+      tester,
+      tabletPrimary,
+      appModules.map((module) => module.title),
+    );
+
+    await _pumpAt(tester, const Size(390, 844));
+    final mobilePrimary = _bottomLabels(tester);
+    expect(mobilePrimary, containsAll(['Membros', 'BAR', 'Mais']));
+    await tester.tap(_bottomMore);
+    await tester.pumpAndSettle();
+    await _expectAllInMoreSheet(
+      tester,
+      mobilePrimary,
+      appModules.map((module) => module.title),
+    );
+  });
+
+  testWidgets(
+      'Responsável Bar e Inventário encontra ambos os módulos em todos os layouts',
+      (tester) async {
+    _authenticateWith(
+      const [
+        'viewBar',
+        'manageBar',
+        'viewInventory',
+        'manageInventory',
+        'sellInventory',
+        'manageMerchandising',
+        'manageAssets',
+        'performInventoryCount',
+      ],
+      role: 'inventory_manager',
+    );
+
+    await _pumpAt(tester, const Size(1600, 1000));
+    await _expectDrawerModules(tester, ['BAR', 'Património & Inventário']);
+    expect(tester.takeException(), isNull);
+
+    await _pumpAt(tester, const Size(800, 1000));
+    final tabletPrimary = _railLabels(tester);
+    expect(tabletPrimary, contains('BAR'));
+    expect(tabletPrimary, contains('Mais'));
+    await tester.tap(_railModule('BAR'));
+    await tester.pumpAndSettle();
+    expect(find.byType(BarScreenV4), findsOneWidget);
+
+    await _pumpAt(tester, const Size(800, 1000));
+    await tester.tap(_railMore);
+    await tester.pumpAndSettle();
+    await _expectAllInMoreSheet(tester, tabletPrimary, _barInventoryExpected);
+    expect(find.text('Património & Inventário'), findsOneWidget);
+    await tester.tap(find.text('Património & Inventário'));
+    await tester.pumpAndSettle();
+    expect(find.byType(InventoryModuleScreen), findsOneWidget);
+
+    await _pumpAt(tester, const Size(390, 844));
+    final mobilePrimary = _bottomLabels(tester);
+    expect(mobilePrimary, contains('BAR'));
+    await tester.tap(_bottomMore);
+    await tester.pumpAndSettle();
+    await _expectAllInMoreSheet(tester, mobilePrimary, _barInventoryExpected);
+    expect(find.text('Património & Inventário'), findsOneWidget);
+    await tester.tap(find.text('Património & Inventário'));
+    await tester.pumpAndSettle();
+    expect(find.byType(InventoryModuleScreen), findsOneWidget);
+
+    await tester.tap(_bottomModule('BAR'));
+    await tester.pumpAndSettle();
+    expect(find.byType(BarScreenV4), findsOneWidget);
+  });
+
+  testWidgets('Membro normal vê Membros mas não vê Bar ou Inventário',
+      (tester) async {
+    _authenticateWith(const ['viewMembers'], role: 'member');
+
+    await _pumpAt(tester, const Size(1600, 1000));
+    await _expectDrawerModules(tester, ['Membros']);
+    expect(_drawerHasModule(tester, 'BAR'), isFalse);
+    expect(_drawerHasModule(tester, 'Património & Inventário'), isFalse);
+    expect(tester.takeException(), isNull);
+
+    await _pumpAt(tester, const Size(800, 1000));
+    final tabletPrimary = _railLabels(tester);
+    expect(tabletPrimary, contains('Membros'));
+    await tester.tap(_railMore);
+    await tester.pumpAndSettle();
+    await _expectAllInMoreSheet(tester, tabletPrimary, _memberExpected);
+    expect(_moreSheetHasModule(tester, 'BAR'), isFalse);
+    expect(_moreSheetHasModule(tester, 'Património & Inventário'), isFalse);
+
+    await _pumpAt(tester, const Size(390, 844));
+    final mobilePrimary = _bottomLabels(tester);
+    expect(mobilePrimary, contains('Membros'));
+    expect(mobilePrimary, isNot(contains('BAR')));
+    await tester.tap(_bottomMore);
+    await tester.pumpAndSettle();
+    await _expectAllInMoreSheet(tester, mobilePrimary, _memberExpected);
+    expect(_moreSheetHasModule(tester, 'BAR'), isFalse);
+    expect(_moreSheetHasModule(tester, 'Património & Inventário'), isFalse);
+  });
+}
+
+void _authenticateWith(
+  Iterable<String> permissionKeys, {
+  required String role,
+}) {
+  final session = AppSession.instance;
+  session.clear();
+  session.authenticate(
+    newProfileId: 'synthetic-menu-profile',
+    newClubId: 'synthetic-menu-club',
+    newFullName: 'Perfil sintético de navegação',
+    newRole: role,
+  );
+  session.applyPermissions(permissionKeys);
+}
+
+Future<void> _pumpAt(WidgetTester tester, Size size) async {
+  await tester.pumpWidget(const SizedBox.shrink());
+  tester.view.physicalSize = size;
+  tester.view.devicePixelRatio = 1;
+  await tester.pumpWidget(const MaterialApp(home: ShellScreen()));
+  await tester.pumpAndSettle();
+}
+
+Future<void> _expectDrawerModules(
+  WidgetTester tester,
+  Iterable<String> expected,
+) async {
+  final scrollable = find
+      .descendant(
+        of: find.byType(NavigationDrawer),
+        matching: find.byType(Scrollable),
+      )
+      .first;
+  for (final title in expected) {
+    final finder = find.descendant(
+      of: find.byType(NavigationDrawer),
+      matching: find.text(title),
+    );
+    await tester.scrollUntilVisible(finder, 120, scrollable: scrollable);
+    expect(finder, findsOneWidget, reason: 'Drawer: $title');
+  }
+}
+
+bool _drawerHasModule(WidgetTester tester, String title) => find
+    .descendant(
+      of: find.byType(NavigationDrawer),
+      matching: find.text(title),
+    )
+    .evaluate()
+    .isNotEmpty;
+
+List<String> _railLabels(WidgetTester tester) => appModules
+    .map((module) => module.title)
+    .where(
+      (title) => find
+          .descendant(
+            of: find.byType(NavigationRail),
+            matching: find.text(title),
+          )
+          .evaluate()
+          .isNotEmpty,
+    )
+    .toList()
+  ..addAll(
+    find
+            .descendant(
+              of: find.byType(NavigationRail),
+              matching: find.text('Mais'),
+            )
+            .evaluate()
+            .isNotEmpty
+        ? ['Mais']
+        : const [],
+  );
+
+List<String> _bottomLabels(WidgetTester tester) => tester
+    .widgetList<NavigationDestination>(find.byType(NavigationDestination))
+    .map((destination) => destination.label)
+    .toList();
+
+Finder get _railMore => find.descendant(
+      of: find.byType(NavigationRail),
+      matching: find.text('Mais'),
+    );
+
+Finder _railModule(String title) => find.descendant(
+      of: find.byType(NavigationRail),
+      matching: find.text(title),
+    );
+
+Finder get _bottomMore => find.byWidgetPredicate(
+      (widget) => widget is NavigationDestination && widget.label == 'Mais',
+    );
+
+Finder _bottomModule(String title) => find.byWidgetPredicate(
+      (widget) => widget is NavigationDestination && widget.label == title,
+    );
+
+Future<void> _expectAllInMoreSheet(
+  WidgetTester tester,
+  List<String> primaryLabels,
+  Iterable<String> expectedTitles,
+) async {
+  final grid = find.byType(GridView).first;
+  final scrollable = find
+      .descendant(
+        of: grid,
+        matching: find.byType(Scrollable),
+      )
+      .first;
+  for (final title in expectedTitles) {
+    if (primaryLabels.contains(title)) continue;
+    final finder = find.descendant(
+      of: grid,
+      matching: find.text(title),
+    );
+    await tester.scrollUntilVisible(finder, 100, scrollable: scrollable);
+    expect(finder, findsOneWidget, reason: 'Mais: $title');
+  }
+}
+
+bool _moreSheetHasModule(WidgetTester tester, String title) => find
+    .descendant(
+      of: find.byType(GridView),
+      matching: find.text(title),
+    )
+    .evaluate()
+    .isNotEmpty;
