@@ -0,0 +1,161 @@
+import 'dart:js_interop';
+import 'dart:js_interop_unsafe';
+
+import 'package:bob_manager_mobile/core/app_config.dart';
+import 'package:bob_manager_mobile/core/app_session.dart';
+import 'package:bob_manager_mobile/screens/login_screen.dart';
+import 'package:bob_manager_mobile/screens/shell_screen.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:integration_test/integration_test.dart';
+import 'package:supabase_flutter/supabase_flutter.dart';
+
+import 'package:bob_manager_mobile/main.dart' as app;
+import 'support/r3_http_trace_client.dart';
+
+const _password = String.fromEnvironment('RC1_TEST_PASSWORD');
+const _clubA = '22000000-0000-0000-0000-000000000001';
+
+void main() {
+  IntegrationTestWidgetsFlutterBinding.ensureInitialized();
+
+  testWidgets('R3 diagnóstico isolado — abertura e saldo Tesouraria',
+      (tester) async {
+    tester.view.physicalSize = const Size(1600, 1000);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(() {
+      tester.view.resetPhysicalSize();
+      tester.view.resetDevicePixelRatio();
+    });
+
+    final api = Uri.parse(AppConfig.supabaseUrl);
+    expect(api.scheme, 'http');
+    expect(api.host, '127.0.0.1');
+    expect(api.port, greaterThan(1024));
+    expect(Uri.base.origin, 'http://127.0.0.1:55139');
+    expect(_password.length, greaterThanOrEqualTo(32));
+    final hadSession = _clearPersistedAuth();
+    debugPrint('[R3-TREASURY] step=clear-auth prior_session=$hadSession');
+
+    final trace = SanitizedHttpTraceClient();
+    await app.main(httpClient: trace);
+    await _pumpUntil(tester, find.byType(LoginScreen));
+    debugPrint('[R3-TREASURY] step=login-screen session=false');
+
+    await tester.enterText(
+      find.byType(TextField).at(0),
+      'rc1-r3-president-a@local.invalid',
+    );
+    await tester.enterText(find.byType(TextField).at(1), _password);
+    await tester.tap(find.widgetWithText(FilledButton, 'Entrar'));
+    await _pumpUntil(tester, find.byType(ShellScreen));
+    debugPrint(
+      '[R3-TREASURY] step=shell auth=${Supabase.instance.client.auth.currentUser != null} '
+      'appSession=${AppSession.instance.authenticated}',
+    );
+
+    final treasury =
+        find.widgetWithText(NavigationDrawerDestination, 'Tesouraria');
+    expect(treasury, findsOneWidget);
+    await tester.ensureVisible(treasury);
+    await tester.tap(treasury);
+    debugPrint('[R3-TREASURY] step=treasury-route-selected');
+
+    final outcome = await _waitForTreasury(tester);
+    debugPrint('[R3-TREASURY] ui_state=$outcome');
+    expect(outcome, startsWith('loaded:'),
+        reason: 'Estado final da Tesouraria: $outcome');
+
+    final client = Supabase.instance.client;
+    final treasuryRows = List<Map<String, dynamic>>.from(
+      await client.rpc(
+        'treasury_account_balances_v1',
+        params: {'target_club': _clubA},
+      ).timeout(const Duration(seconds: 30)) as List,
+    );
+    final treasuryTotal = treasuryRows.fold<double>(
+      0,
+      (sum, row) => sum + (row['balance'] as num).toDouble(),
+    );
+    final displayedGlobalBalance =
+        outcome.substring('loaded:'.length).split('|').first;
+    expect(displayedGlobalBalance, _formatMoney(treasuryTotal));
+
+    final directBalances = await client
+        .from('v_financial_balances')
+        .select('club_id,balance')
+        .eq('club_id', _clubA)
+        .timeout(const Duration(seconds: 30));
+    expect(directBalances, hasLength(1));
+    expect((directBalances.single['balance'] as num).toDouble(), 400.0);
+    debugPrint(
+      '[R3-TREASURY] step=balance-compare ui=${_formatMoney(treasuryTotal)} '
+      'treasury_rpc_rows=${treasuryRows.length} r10_view=400.00',
+    );
+
+    debugPrint('[R3-TREASURY] request_trace_count=${trace.events.length}');
+    for (final event in trace.events) {
+      debugPrint('[R3-HTTP] $event');
+    }
+  });
+}
+
+bool _clearPersistedAuth() {
+  final storage = globalContext.getProperty<JSObject?>('localStorage'.toJS);
+  if (storage == null) throw StateError('Browser localStorage unavailable');
+  final prefix = Uri.parse(AppConfig.supabaseUrl).host.split('.').first;
+  final key = 'sb-$prefix-auth-token';
+  final prior = storage.callMethod<JSString?>('getItem'.toJS, key.toJS);
+  storage.callMethod<JSAny?>('removeItem'.toJS, key.toJS);
+  return prior != null && prior.toDart.isNotEmpty;
+}
+
+Future<String> _waitForTreasury(WidgetTester tester) async {
+  final deadline = DateTime.now().add(const Duration(seconds: 35));
+  var loadingSeen = false;
+  while (DateTime.now().isBefore(deadline)) {
+    if (find.text('Saldo global').evaluate().isNotEmpty) {
+      final amount = find
+          .textContaining('€')
+          .evaluate()
+          .map((element) {
+            final widget = element.widget;
+            return widget is Text ? widget.data ?? '' : '';
+          })
+          .where((text) => text.isNotEmpty)
+          .toList();
+      return 'loaded:${amount.join('|')}';
+    }
+    final error = find.textContaining('Erro:').evaluate();
+    if (error.isNotEmpty) {
+      final message = (error.first.widget as Text).data ?? 'unknown';
+      return 'http_or_parse_error:${_sanitize(message)}';
+    }
+    loadingSeen = loadingSeen ||
+        find.byType(CircularProgressIndicator).evaluate().isNotEmpty;
+    await tester.pump(const Duration(milliseconds: 200));
+  }
+  return loadingSeen
+      ? 'pending_future_loading_indicator'
+      : 'no_treasury_content';
+}
+
+String _sanitize(String value) => value
+    .replaceAll(
+        RegExp(r'eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+'), '[JWT]')
+    .replaceAll(
+        RegExp(r'(bearer\s+)[^\s]+', caseSensitive: false), r'$1[redacted]')
+    .replaceAll(RegExp(r'[\w.+-]+@[\w.-]+'), '[email]')
+    .replaceAll(RegExp(r'\b[0-9a-fA-F-]{32,}\b'), '[id]');
+
+String _formatMoney(double amount) =>
+    '${amount.toStringAsFixed(2).replaceAll('.', ',')} €';
+
+Future<void> _pumpUntil(WidgetTester tester, Finder finder) async {
+  final deadline = DateTime.now().add(const Duration(seconds: 35));
+  while (DateTime.now().isBefore(deadline)) {
+    if (finder.evaluate().isNotEmpty) return;
+    await tester.pump(const Duration(milliseconds: 200));
+  }
+  expect(finder, findsOneWidget, reason: 'Timeout at $finder');
+}
