+alter table public.club_memberships
+  add constraint club_memberships_access_role_check
+  check (access_role = any (array[
+    'member'::text,
+    'prospect'::text,
+    'treasurer'::text,
+    'secretary'::text,
+    'road_captain'::text,
+    'sergeant_at_arms'::text,
+    'event_manager'::text,
+    'events_manager'::text,
+    'inventory_manager'::text,
+    'euromillions_manager'::text,
